# ============================================
# DevFlow - Environment Configuration
# ============================================
# Copy this file to .env and adjust values:
#   cp .env.example .env
# ============================================

# ---- Spring Profile ----
# Options:
#   dev  (default)  → show-sql=true, ddl-auto=update, CORS localhost
#   prod            → show-sql=false, ddl-auto=validate, CORS domain
SPRING_PROFILES_ACTIVE=dev

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devflow
DB_USERNAME=postgres
DB_PASSWORD=

# ---- JWT ----
# Secret must be at least 256 bits (32 chars) for HS256
JWT_SECRET=
# Token expiry: 24 hours (milliseconds)
JWT_EXPIRATION_MS=86400000
